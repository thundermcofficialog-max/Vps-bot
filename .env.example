# Discord bot token (Developer Portal → Bot → Token)
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Your Discord user ID — always treated as super_admin
OWNER_ID=123456789012345678

# Channel where redeem/renew/port approval requests get posted
ADMIN_LOG_CHANNEL_ID=0

# Channel used by /announcement
ANNOUNCE_CHANNEL_ID=0

# SQLite file path
DB_PATH=vpsbot.db

# Minimum Discord account age (days) required for /verify
MIN_ACCOUNT_AGE_DAYS=90

# "lxc" for LXD, "incus" if you're using Incus
LXC_BIN=lxc
